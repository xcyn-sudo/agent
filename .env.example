# ============================================
# Agent-QR Docker 环境变量示例
# 复制为 .env 后修改实际值
# ============================================

# MySQL 配置
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=agent_qr

# JWT 配置
JWT_SECRET=change-me-to-a-random-secret-string
JWT_EXPIRATION=86400000

# DeepSeek API 配置 (必填)
DEEPSEEK_API_KEY=your-deepseek-api-key

# DashScope (千问) Embedding API 配置 (必填)
# 获取地址: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your-dashscope-api-key

# Embedding Provider 选择: dashscope (云部署) | ollama (本地开发)
EMBEDDING_PROVIDER=dashscope

# 文件上传目录 (宿主机相对路径或绝对路径)
UPLOAD_DIR=./uploads

# 阿里云 ACR 镜像仓库 (CI/CD 使用)
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com/your-namespace

# 镜像标签 (默认 latest)
IMAGE_TAG=latest
