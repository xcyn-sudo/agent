# ============================================
# Agent-QR Docker 环境变量示例
# 复制为 .env 后修改实际值
# ============================================

# MySQL 配置
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=agent_qr
MYSQL_PORT=3308

# JWT 配置
JWT_SECRET=change-me-to-a-random-secret-string
JWT_EXPIRATION=86400000

# DeepSeek API 配置 (必填)
DEEPSEEK_API_KEY=your-deepseek-api-key

# 文件上传目录 (宿主机相对路径或绝对路径)
UPLOAD_DIR=./uploads

# ChromaDB 端口
CHROMA_PORT=8000

# 后端端口
BACKEND_PORT=9090
