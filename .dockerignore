# ============================================
# Docker 构建忽略文件
# 加速构建并防止敏感文件进入镜像
# ============================================

# Git
.git
.gitattributes
.gitignore

# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr

# Maven 构建产物
target/
*.jar
!agent-qr-web/target/*.jar

# 环境变量 (通过 docker-compose 注入)
.env
.env.local

# 日志
doc/log/
*.log

# 临时文件
*.tmp
*.swp
*.swo
*~

# Docker
Dockerfile*
docker-compose*
.dockerignore

# CI/CD & 部署脚本（仅用于云部署，不进入后端镜像）
.github/
nginx/
scripts/
.claude/
.codegraph/

# 前端（独立构建和部署）
agent-qr-web-frontend/

# 文档 & PPT
doc/
ppt/

# 杂项
*.zip

# OS
Thumbs.db
.DS_Store

# 上传目录
uploads/
