        {
          "name": "查不存在的文档",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/knowledge/documents/99999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "knowledge", "documents", "99999"]
            },
            "description": "查询不存在的文档 ID，应返回 404"
          },
          "response": []
        },
        {
          "name": "查不存在文档的状态",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/knowledge/documents/99999/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "knowledge", "documents", "99999", "status"]
            },
            "description": "查询不存在文档的状态，应返回 404"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin",
      "description": "管理员用户管理接口 — CRUD、状态切换",
      "item": [
        {
          "name": "用户列表",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.data && json.data.records && json.data.records.length > 0) {",
                  "        const first = json.data.records[0];",
                  "        pm.environment.set('lastUserId', first.id);",
                  "        console.log('lastUserId 已更新: ' + first.id + ' (' + first.username + ')');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users?page=1&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "分页查询用户列表，将第一条用户的 ID 写入 lastUserId"
          },
          "response": []
        },
        {
          "name": "搜索用户",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users?page=1&size=10&keyword=test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "size", "value": "10" },
                { "key": "keyword", "value": "test" }
              ]
            },
            "description": "按用户名搜索用户"
          },
          "response": []
        },
        {
          "name": "创建用户",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    console.log('用户创建成功');",
                  "    // 新用户ID需要通过列表查询获取，此处仅记录",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser_crud\",\n  \"password\": \"123456\",\n  \"realName\": \"测试用户\",\n  \"email\": \"test@example.com\",\n  \"role\": \"user\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"]
            },
            "description": "创建新用户（默认状态=1启用，角色=user）"
          },
          "response": []
        },
        {
          "name": "创建用户-用户名重复",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser_crud\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"]
            },
            "description": "重复用户名应返回 BusinessException"
          },
          "response": []
        },
        {
          "name": "更新用户信息",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"realName\": \"张三改\",\n  \"phone\": \"13800138000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{lastUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{lastUserId}}"]
            },
            "description": "更新用户信息，仅更新非空字段"
          },
          "response": []
        },
        {
          "name": "禁用用户",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{lastUserId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{lastUserId}}", "status"]
            },
            "description": "将用户状态设置为 0（禁用）。\n✅ 本次修复：@RequestParam → @RequestBody"
          },
          "response": []
        },
        {
          "name": "启用用户",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{lastUserId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{lastUserId}}", "status"]
            },
            "description": "将用户状态设置为 1（启用）。\n✅ 本次修复：@RequestParam → @RequestBody"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin-边界状态",
      "description": "用户状态切换边界测试 — 验证 @Min/@Max/@NotNull 校验生效",
      "item": [
        {
          "name": "status=-1 负数",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": -1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{lastUserId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{lastUserId}}", "status"]
            },
            "description": "负数应被 @Min(0) 拦截，返回 400"
          },
          "response": []
        },
        {
          "name": "status=2 超范围",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{lastUserId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{lastUserId}}", "status"]
            },
            "description": "超出范围应被 @Max(1) 拦截，返回 400"
          },
          "response": []
        },
        {
          "name": "status=null 空值",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{lastUserId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{lastUserId}}", "status"]
            },
            "description": "null 应被 @NotNull 拦截，返回 400"
          },
          "response": []
        },
        {
