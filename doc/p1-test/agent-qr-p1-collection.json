            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"abc\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{lastUserId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{lastUserId}}", "status"]
            },
            "description": "字符串类型的 status 无法转为 Integer，应返回 400"
          },
          "response": []
        },
        {
          "name": "不存在的用户ID",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/99999/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "99999", "status"]
            },
            "description": "不存在的用户 ID 应返回 404（BusinessException）"
          },
          "response": []
        },
        {
          "name": "普通用户Token访问Admin接口",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"]
            },
            "description": "如果当前 Token 是普通用户（非 admin 角色），应返回 403。\n⚠ 当前环境用 usertest（role=admin），此用例需配合普通用户 Token 测试。"
